#!/usr/bin/env bash
# Pre-commit hook: lint staged Markdown files with tools.mdlint.
#
# Enable:  git config core.hooksPath .githooks
# Bypass:  git commit --no-verify
#
# Language routing lives inside tools.mdlint (--auto-lang); this hook only
# collects the staged Markdown files and delegates a fix + check pass per
# file, so the routing rules stay unit-testable in one place.

set -euo pipefail

# Collect staged Markdown files (Added/Copied/Modified only).  -z keeps the
# paths verbatim: the default output quotes and octal-escapes non-ASCII names,
# which the plain `case` filter below would then miss.
FILES=()
while IFS= read -r -d '' path; do
    case $path in
        *.md) FILES+=("$path") ;;
    esac
done < <(git diff --cached --name-only -z --diff-filter=ACM)

if [ ${#FILES[@]} -eq 0 ]; then
    exit 0
fi

# Resolve the interpreter: prefer the repo venv (Windows and POSIX layouts),
# then python3/python from PATH.  When no interpreter can be found at all,
# warn and let the commit pass: a broken environment must not block
# documentation commits.
ROOT=$(git rev-parse --show-toplevel)
PY=""
for candidate in "$ROOT/.venv/Scripts/python.exe" "$ROOT/.venv/bin/python"; do
    if [ -f "$candidate" ]; then
        PY="$candidate"
        break
    fi
done
if [ -z "$PY" ]; then
    if command -v python3 >/dev/null 2>&1; then
        PY=python3
    elif command -v python >/dev/null 2>&1; then
        PY=python
    fi
fi
if [ -z "$PY" ]; then
    echo "mdlint: no Python interpreter found; skipping Markdown lint" >&2
    exit 0
fi

# Probe the backend once.  A missing pymarkdownlnt (it is a dev extra) makes
# the CLI exit 1 on a traceback, which would be indistinguishable from
# "violations found" and would block the commit for the wrong reason.
if ! "$PY" -m tools.mdlint --list-rules >/dev/null 2>&1; then
    echo "mdlint: linter unavailable (pip install -e .[dev]); skipping Markdown lint" >&2
    exit 0
fi

# Fix pass (auto-fix what is fixable; anything left surfaces in the check
# pass), re-stage the file only when the fix actually changed it, then check:
# remaining violations block the commit.  Exit code 2 means the linter itself
# failed on that file (pymarkdown trips on a few pathological documents); that
# is a warning, never a commit blocker.
EXIT=0
for f in "${FILES[@]}"; do
    "$PY" -m tools.mdlint --fix --auto-lang --quiet "$f" || true
    if ! git diff --quiet -- "$f"; then
        # The working-tree copy is what the linter reviewed; staging it here is
        # deliberate (a fix must land in the commit, not stay unstaged).
        git add -- "$f"
    fi
    set +e
    "$PY" -m tools.mdlint --check --auto-lang --quiet "$f"
    CODE=$?
    set -e
    case $CODE in
        0) ;;
        1)
            echo "mdlint: $f has remaining violations" >&2
            EXIT=1
            ;;
        *)
            echo "mdlint: could not lint $f; skipping it" >&2
            ;;
    esac
done

exit $EXIT
