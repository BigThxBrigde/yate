# EditorConfig: https://EditorConfig.org
#
# Conventions mirrored from the repo itself:
# - canonical line endings are LF (see `git ls-files --eol` and .gitattributes);
#   CRLF in a Windows working tree is produced by core.autocrlf, not by editors
# - Python style (.trae/rules/python-coding-style.md): 4-space indent,
#   100-column limit, files end with a newline
# - Lua style (yate/extensions/): 2-space indent, uniform across the API
#   library, bundled extensions and lua.example
# - .gitattributes: *.sh and *.lua must stay LF (a CRLF shebang breaks on
#   Linux; CR bytes are rejected by tools/lint_lua.py)

# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python sources, type stubs (typings/), PyInstaller spec files (Python
# syntax, exec'd by pyinstaller), and Python-based config examples
# (yaterc.example, themes, *.py.example extension templates).
[*.{py,pyi,spec,example}]
indent_style = space
indent_size = 4
max_line_length = 100

# The one Lua-syntax example follows the Lua style below, not the Python
# style above (this section must come after it to win).
[lua.example]
indent_style = space
indent_size = 2

# Lua extension scripts (yate/extensions/): 2-space indent throughout;
# LF is additionally enforced by .gitattributes.
[*.lua]
indent_style = space
indent_size = 2

# Tree-sitter query files (yate/editor_syntax/ts_backend/queries/).
[*.scm]
indent_style = space
indent_size = 2

# Textual CSS resources (yate/resources/).
[*.tcss]
indent_style = space
indent_size = 4

# PowerShell scripts (pack/, tools/probes/).
[*.ps1]
indent_style = space
indent_size = 4

# Machine-written JSON (smoke-test baselines) uses 2-space indent.
[*.json]
indent_style = space
indent_size = 2

# CI workflows (.github/workflows/, .workflow/) use 2-space indent.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 4

# Markdown: keep trailing double-spaces (hard line breaks).
[*.md]
trim_trailing_whitespace = false

# Shell scripts must keep LF even on Windows (mirrors .gitattributes).
[*.sh]
end_of_line = lf

# Windows batch files require CRLF to be parsed reliably.
[*.{bat,cmd}]
end_of_line = crlf
