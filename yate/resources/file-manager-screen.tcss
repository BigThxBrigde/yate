/* FileManagerScreen stylesheet (class-scoped DEFAULT_CSS) --
   loaded by editor_components/file_manager/screen.py via yate.paths.load_tcss.
   Selector ids are owned by this component (no shell CSS references).
   Every color is a Textual theme token bridged from yate.Theme; there are
   deliberately no literal hex values in this file. */
FileManagerScreen {
    align: center middle;
}
FileManagerScreen #file-manager {
    width: 90%;
    height: 80%;
    background: $surface;
}
FileManagerScreen.fullscreen #file-manager {
    width: 100%;
    height: 100%;
}
/* One-row bands: a one-row box has no vertical excess space, so Textual's
   middle alignment cannot shift the glyphs.  Keep the chrome compact instead
   of spending two extra rows per band on blank padding; the body's top and
   bottom rules provide the visual separation. */
FileManagerScreen #file-manager-head {
    height: 1;
    background: $surface;
}
FileManagerScreen #file-manager-head > Static {
    height: 1;
    color: $primary;
    text-style: bold;
    padding: 0 1;
}
FileManagerScreen #file-manager-parent-head {
    width: 1fr;
    border-right: solid $foreground 12%;
}
FileManagerScreen #file-manager-list-head {
    width: 2fr;
    border-right: solid $foreground 12%;
}
FileManagerScreen #file-manager-preview-head {
    width: 2fr;
}
FileManagerScreen #file-manager-body {
    height: 1fr;
    border-top: solid $foreground 12%;
    border-bottom: solid $foreground 12%;
}
FileManagerScreen #file-manager-parent {
    width: 1fr;
    padding: 0 1;
    border-right: solid $foreground 12%;
}
FileManagerScreen #file-manager-list {
    width: 2fr;
    padding: 0 1;
    border-right: solid $foreground 12%;
}
FileManagerScreen #file-manager-list > ListItem.-highlight {
    background: $primary;
    color: $block-cursor-foreground;
    text-style: bold;
}
FileManagerScreen #file-manager-list:focus > ListItem.-highlight {
    background: $primary;
    color: $block-cursor-foreground;
    text-style: bold;
}
FileManagerScreen #file-manager-preview {
    width: 2fr;
    padding: 0 1;
}
FileManagerScreen #file-manager-input {
    height: 1;
    display: none;
    border: none;
    padding: 0 1;
    background: $surface;
}
FileManagerScreen #file-manager-input.active {
    display: block;
    height: 2;
    border-top: solid $foreground 12%;
}
FileManagerScreen #file-manager-status {
    height: 1;
    padding: 0 1;
    background: $surface;
}
FileManagerScreen Widget {
    scrollbar-size-vertical: 1;
}
