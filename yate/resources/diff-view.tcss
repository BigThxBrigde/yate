/* DiffScreen stylesheet (class-scoped DEFAULT_CSS) --
   loaded by editor_view/diffview.py via yate.paths.load_tcss.
   Layout skeleton only: exact diff tinting is painted by DiffPane from
   the yate theme palette (yate.editor_view.theme), colors here reference
   Textual theme variables (bridged from the active yate theme). */

DiffScreen {
    align: center middle;
}

DiffScreen #diff-screen {
    width: 100%;
    height: 100%;
    background: $background;
}

DiffScreen #diff-header {
    dock: top;
    height: 1;
    background: $panel;
    color: $text;
    padding: 0 1;
}

DiffScreen #diff-body {
    height: 1fr;
}

DiffScreen DiffPane {
    width: 1fr;
    border-right: solid $border;
}

DiffScreen #diff-hint {
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
}
