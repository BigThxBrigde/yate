/* PaneHost widget stylesheet (class-scoped DEFAULT_CSS) --
   loaded by editor_view/panes.py via yate.paths.load_tcss. */
PaneHost {
    width: 100%;
    height: 1fr;
}
.pane-box {
    width: 100%;
    height: 100%;
}
PaneHost EditorView {
    width: 100%;
    height: 100%;
}
/* divider between two panes of a split; only the first side gets it */
.pane-sep-h {
    border-bottom: tall $foreground 25%;
}
.pane-sep-v {
    border-right: tall $foreground 25%;
}
