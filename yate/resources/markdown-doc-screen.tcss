/* MarkdownDocScreen widget stylesheet (class-scoped DEFAULT_CSS) --
   loaded by editor_view/manual.py via yate.paths.load_tcss. */
MarkdownDocScreen {
    align: center middle;
}
MarkdownDocScreen #doc-box {
    width: 90%;
    height: 90%;
    background: $surface;
    border: tall $foreground 15%;
    padding: 0 2;
}
MarkdownDocScreen #doc-search-bar {
    height: 3;
    padding: 0 1;
    background: $surface;
    display: none;
}
MarkdownDocScreen #doc-search-input {
    width: 1fr;
    height: 3;
    border: none;
    background: $surface;
    padding: 0;
}
MarkdownDocScreen #doc-search-status {
    width: auto;
    min-width: 14;
    height: 1;
    padding: 1 1;
    color: $text-muted;
    background: $surface;
}
MarkdownDocScreen #doc-scroll {
    height: 1fr;
}
/* the body is one widget whose height is its row count (DocBody.
   get_content_height), so it must size to content -- 1fr would pin it to the
   viewport and nothing would scroll */
MarkdownDocScreen #doc-md {
    height: auto;
    width: 1fr;
}
MarkdownDocScreen #doc-loading {
    height: 1;
    padding: 1 0;
    color: $text-muted;
}
MarkdownDocScreen .hint {
    height: 1;
    color: $text-muted;
    text-align: center;
}
/* The document body is one widget holding pre-rendered rows (see
   editor_view/manual.py:DocBody): search tints are painted into those rows
   from the active yate theme's yellow accent, so no per-block rules (and no
   MarkdownTable width rule) are needed here any more. */
