"""Example yate extension (template, not auto-loaded).

This file ships as ``yate/extensions/example_ext.py.example``; the ``.example``
suffix keeps it out of the startup ``*.py`` scan. Easiest install: run
``yate --setup-defaults``, which places it at
``~/.yate/extensions/example_ext.py.example``, then rename that copy to
``example_ext.py`` and restart yate. To install by hand, copy it (without
the suffix) into an extension directory::

    copy yate\\extensions\\example_ext.py.example ^
        %USERPROFILE%\\.yate\\extensions\\example_ext.py      (cmd)
    cp yate/extensions/example_ext.py.example \
        ~/.yate/extensions/example_ext.py                     (POSIX)

or load the copied file explicitly with ``yate --ext example_ext.py``.

Note: the ``*.example`` copy installed by ``yate --setup-defaults`` is a
yate-managed file -- re-running setup (e.g. on upgrade) overwrites it, so
do your experimenting in the renamed ``*.py`` file, not in the ``.example``.

An extension is any module with a ``setup(api)`` function. The api exposes:

* ``api.command(name, description)``           -- decorator for ``:`` commands
* ``api.register_command(name, func, desc)``   -- imperative version
* ``api.bind_key(spec, func, keymap=...)``     -- key binding (decorator-able)
* ``api.register_action(name, func)``          -- named action
* ``api.buffer`` / ``api.doc`` / ``api.workspace``
* ``api.shell(command)`` / ``api.open_path(p)`` / ``api.save()``
* ``api.message(text)``
* ``api.lsp.register_server(name, command=..., filetypes=..., ...)``
  ``api.lsp.statuses()`` -- language server protocol support
* ``api.highlight.register(spec, *extensions)`` -- custom syntax highlighting
  via a declarative ``LangSpec`` (see ``batch_syntax.py.example`` for one)
* ``api.syntax.register_tree_sitter(name, grammar=..., extensions=...,
  query=...)`` -- tree-sitter grammar based highlighting for custom
  languages (see ``yatesh_syntax.py.example``; requires ``yate[ts]``)
* ``api.events.subscribe(api.events.EditorEvent.X, fn)`` -- editor event
  subscription, returns the unsubscribe thunk (see section 4.10 of the
  extensions manual)
* ``api.ui.add_segment(id, provider, align=..., priority=...)`` -- status
  bar text segments (see section 4.11 of the extensions manual)
* ``api.actions.run(name)`` / ``api.bind_action(key, action, keymap=...)``
  -- run actions by name / rebind keys to registered actions (see section
  4.12 of the extensions manual)

Note: this example registers commands with the imperative
``api.register_command`` (which carries a fully typed signature) and looks up
``api.bind_key`` dynamically -- its declared signature uses a bare ``Callable``
for the callback, so a direct reference is not representable under strict
type checking.
"""

from __future__ import annotations

from typing import Callable

from yate.keymaps.base import ActionContext
from yate.services.extensions import ExtensionAPI
from yate.services.shell import ShellResult

#: Unsubscribe thunks of the event subscriptions made in :func:`setup`,
#: dropped again in :func:`teardown` (module-level because the two hooks
#: are separate functions).
_UNSUBSCRIBE: list[Callable[[], None]] = []


def setup(api: ExtensionAPI) -> None:
    # --- :upper -- uppercase the selection, or the whole current line
    def upper(_args: str) -> None:
        buf = api.buffer
        if buf.has_selection():
            text = buf.selected_text() or ""
            buf.insert_text(text.upper())
        else:
            row = buf.row
            buf.lines[row] = buf.lines[row].upper()
            buf.mark_content_changed()
        api.message("uppercased!")

    api.register_command("upper", upper, "uppercase selection (or current line)")

    # --- :lower -- the opposite
    def lower(_args: str) -> None:
        buf = api.buffer
        if buf.has_selection():
            text = buf.selected_text() or ""
            buf.insert_text(text.lower())
        else:
            row = buf.row
            buf.lines[row] = buf.lines[row].lower()
            buf.mark_content_changed()
        api.message("lowercased!")

    api.register_command("lower", lower, "lowercase selection (or current line)")

    # --- :words -- word count of the whole document
    def words(_args: str) -> None:
        count = len(api.buffer.get_text().split())
        api.message(f"word count: {count}")

    api.register_command("words", words, "count words in the document")

    # --- :sh <cmd> -- run a shell command and report its output length
    def sh(args: str) -> None:
        if not args.strip():
            api.message("usage: :sh <command>")
            return
        result = api.shell(args)
        if isinstance(result, ShellResult):
            lines = len(result.output.splitlines())
            api.message(f"{args!r} exited {result.returncode} ({lines} lines of output)")

    api.register_command("sh", sh, "run a shell command (usage: :sh <command>)")

    # --- key binding, available in BOTH key maps
    def _upper_key(_ctx: ActionContext) -> None:
        upper("")

    # ExtensionAPI.bind_key takes a bare Callable for its callback; fetch it
    # dynamically at this single registration boundary.
    bind_key: Callable[..., None] = getattr(api, "bind_key")
    bind_key(
        "<alt-u>",
        _upper_key,
        keymap="both",
        description="uppercase selection/line (extension)",
        category="extension",
    )

    # --- named actions: register first, then bind -- bind_action references
    # the action by name, and a failing setup restores the previous binding.
    api.register_action("ext.upper", lambda ctx: upper(""),
                        "uppercase selection (or current line)")
    api.bind_action("<ctrl-shift-alt-u>", "ext.upper", keymap="both")

    # --- editor events: report theme switches. The event enum is
    # re-exported as api.events.EditorEvent, so no yate.services import is
    # needed; each payload is a frozen dataclass. The unsubscribe thunk is
    # kept around so teardown can drop the listener again.
    def _on_theme(payload) -> None:
        api.message(f"theme switched to {payload.name}")

    _UNSUBSCRIBE.append(
        api.events.subscribe(api.events.EditorEvent.THEME_CHANGED, _on_theme)
    )

    # --- status bar segment: live word count on the right bar half; a
    # provider returning None/"" would hide the segment for that refresh.
    # The bar refreshes on every cursor move -- keep providers cheap.
    api.ui.add_segment(
        "ext-wordcount",
        lambda: f"{len(api.buffer.get_text().split())}w",
        align="right",
    )


def teardown(api: ExtensionAPI) -> None:
    # Mirror of setup: drop the event subscription and the status segment
    # (registrations made while setup runs would also roll back on their
    # own if setup failed -- this hook covers the healthy shutdown path).
    for unsub in _UNSUBSCRIBE:
        unsub()
    _UNSUBSCRIBE.clear()
    api.ui.remove_status_segment("ext-wordcount")
