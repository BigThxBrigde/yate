--[[
yate Lua extension example (lua.example)

Usage: copy this file into an extension directory (recommended:
~/.yate/extensions/), rename it to ``<name>.lua`` (for example
``hello.lua``) and restart yate; it is loaded automatically.
Requires the optional dependency: pip install yate[lua]

Lua extensions come in two styles mirroring the Python hook model:
**the file's top-level code is the setup** (the idiom used below), or a
global ``function setup(api)`` called once after the top level has run
(see the commented block at the bottom).  An optional global
``teardown(api)`` works in both styles and runs when yate exits.  Errors
never crash the editor: load-time failures are reported on the message
line as ``extension <name>: ...`` with everything already registered
rolled back, and runtime errors inside command/key/action callbacks are
caught and reported the same way.
]]

-- Grab yate's built-in API library (require("yate") and the global yate
-- are the same table; pick either).  The library source lives in the
-- package as _yate.lua: message / register_command / register_action /
-- bind_key / bind_action / unbind_key / shell / open_path / save / buffer /
-- doc / workspace / events.subscribe / ui.add_segment / theme / clipboard /
-- docs / actions, plus the raw bridge passthroughs api / keymaps /
-- highlight / sprites / lsp / syntax.
local yate = require("yate")

-- Register the :lua-hello command: reports the current document's line
-- count, first line and the command arguments.  Three things to note:
-- Python lists are 0-based (buf.lines[0] is the first line); Lua's
-- length operator # does not work on Python objects -- take lengths with
-- python.builtins.len instead; and indexing an empty Python list raises
-- IndexError (it does not yield nil), so guard before reading lines[0].
yate.register_command("lua-hello", function(args)
  local buf = yate.buffer()
  local total = python.builtins.len(buf.lines)
  local first = ""
  if total > 0 then
    first = buf.lines[0] or ""
  end
  yate.message(string.format("lua-hello! %d lines in total, first: %s; args: %s",
                             total, first, args or ""))
end, "greet from a lua extension")

-- Bind Alt+H (the 3rd positional argument "both" binds the vsc and vim
-- keymaps at once; omit it to default to "vsc").  The callback receives
-- an ActionContext and may ignore it.
yate.bind_key("<alt-h>", function(ctx)
  -- Command callbacks are plain Lua closures: reuse them directly instead
  -- of reaching back through the Python-side registry.
  yate.message("Alt+H fired the lua extension! Try :lua-hello")
end, "both")

-- Load-time hint (this line demonstrates "top-level is setup": it runs
-- while the script loads).
yate.message("lua example extension loaded (trigger with :lua-hello or Alt+H)")

-- Optional: define a global teardown(api) to release resources when yate
-- exits (mirrors a Python extension's teardown(api)).  Uncomment when
-- needed:
-- teardown = function(api)
--   -- release the resources held by this extension (subprocesses, timers, ...)
-- end

-- Alternative: the explicit setup(api) style (mirrors a Python extension's
-- setup hook).  yate calls it once with the same api object after the top
-- level has run -- handy when helper functions are declared above the
-- registrations.  Pick ONE style per script: with both present the top
-- level runs first and setup(api) is then called on top of it.
-- Uncomment to switch (and remove the top-level registrations above):
-- function setup(api)
--   yate.register_command("lua-explicit", function(args)
--     yate.message("explicit setup style, args: " .. (args or ""))
--   end, "greet from the explicit setup style")
-- end

-- Events, status bar segments and action bindings, in the explicit
-- setup(api) style (merge into the setup block above, or uncomment as a
-- whole).  Three ordering notes: subscribe returns the unsubscribe
-- function -- keep it and call it from teardown, so a reloaded extension
-- does not stack duplicate listeners; bind_action references an action BY
-- NAME, so the action must be registered first (register_action, then
-- bind_action); and the status segment's align / priority may be left nil
-- to get the defaults ("right" / 0).
-- local unsub = nil
-- function setup(api)
--   unsub = yate.events.subscribe("document_saved", function(payload)
--     yate.message("saved: " .. tostring(payload.doc.path))
--   end)
--   yate.ui.add_segment("lua-segment", function()
--     return "lua"
--   end)
--   yate.register_action("my_action", function(ctx)
--     yate.message("my_action fired!")
--   end, "demo action bound below")
--   yate.bind_action("gq", "my_action")
-- end
-- function teardown(api)
--   if unsub ~= nil then
--     unsub()  -- drop the event listener again
--   end
-- end

