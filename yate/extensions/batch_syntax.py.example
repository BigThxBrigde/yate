"""DOS batch syntax highlighting for yate, as a copy-to-use extension.

Copy this file to ``~/.yate/extensions/batch_syntax.py`` (or a project
``./extensions/`` directory) without the ``.example`` suffix; it then loads
at startup and ``.bat`` / ``.cmd`` files highlight automatically. The type
is also selectable manually with ``:set filetype=bat``.

The highlighter is a declarative :class:`LangSpec` registered through the
documented extension surface (``api.highlight.register``): the built-in
tokenizer already handles strings, numbers, labels and word coloring --
only the word lists are language specific.

Note: ``api.highlight.register`` pins the registered extensions to the
regex backend, which is what a simple line-oriented language like batch
wants.
"""

from __future__ import annotations

from yate.services.extensions import ExtensionAPI

_BAT_KEYWORDS: frozenset[str] = frozenset({
    "echo", "off", "on", "set", "setlocal", "endlocal", "if", "exist", "not",
    "else", "for", "in", "do", "goto", "call", "exit", "shift", "pause",
    "cls", "rem", "defined", "errorlevel", "enabledelayedexpansion",
    "enableextensions", "type", "del", "copy", "move", "mkdir", "rmdir",
    "cd", "pushd", "popd", "start", "title", "where", "choice",
})


def setup(api: ExtensionAPI) -> None:
    """Register the DOS batch highlighter for ``.bat`` / ``.cmd`` files."""
    spec = api.highlight.spec(
        name="batch",
        mode="code",
        line_comment="rem",
        keywords=_BAT_KEYWORDS,
    )
    api.highlight.register(spec, "bat", "cmd")
