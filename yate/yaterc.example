# yaterc — yate configuration file (Python syntax, like vimrc/init.vim).
#
# Easiest install: run `yate --setup-defaults`, which creates ~/.yate/ and
# copies this file there as ~/.yate/yaterc (an existing yaterc is kept;
# --force replaces it and saves the old one as yaterc.yate-bak).
#
# Or copy this file by hand to one of:
#   ~/.yate/yaterc     user configuration (loaded first)
#   ./yaterc           project configuration (loaded second, wins on conflict)
# or pass an explicit path with:  yate -u /path/to/yaterc
# (`yate -u NONE` starts without loading any configuration file.)
#
# Everything below is plain Python: options are module-level variables,
# invalid values are reported on the message line at startup and fall back
# to defaults — a broken yaterc never crashes the editor.

# ---------------------------------------------------------------- options

# Key map: "vsc" (VS Code style, default) or "vim".
keymap = "vsc"

# Color theme: one of the eight built-in themes
#   Catppuccin: mocha (default, dark) | macchiato | frappe | latte (light)
#   One/Gruvbox: onedark | onelight (light) | gruvbox-dark | gruvbox-light
# or the name of a custom theme registered below (Dracula/Ayu templates
# ship under yate/resources/theme_examples/, copy to a theme dir as *.py).
theme = "mocha"

# Indentation: spaces per tab stop (1–16) and whether the Tab key inserts
# spaces. Applied to every new/opened buffer.
tab_width = 4
use_spaces = True

# Integrated terminal (toggle with Ctrl+grave, the key above Tab):
# shell sets the command launched in the bottom terminal panel.
# Defaults: Windows pwsh -> Windows PowerShell -> cmd.exe;
#           POSIX $SHELL -> bash -> /bin/sh.
# Arguments are allowed (split like a command line); on Windows an existing
# file path is used verbatim, so quoted paths with spaces work.
#
# shell = "pwsh -NoLogo"
# shell = r"C:\Program Files\PowerShell\7\pwsh.exe"
# shell = "/usr/bin/zsh"
#
# Panel height in rows (3–40, default 12); :set terminal_height=<n> also
# changes it for the current session.
#
# terminal_height = 12

# ------------------------------------------------------------- trace log
#
# Runtime debug log, off by default: nothing is written until it is turned
# on. Files land in ~/.yate/data/logs/yate-YYYYMMDD-HHMMSS.log (next to the
# crash-*.err reports), one per process, appended to.
#
# The level names are Python's built-in logging levels (case-insensitive):
# DEBUG (10) | INFO (20) | WARNING (30) | ERROR (40) | CRITICAL (50).
#
# yate_trace = True
# yate_trace_level = "DEBUG"
#
# Per-session override (higher priority than this file), no rc edit needed:
#   YATE_TRACE=1 YATE_TRACE_LEVEL=INFO yate          (POSIX)
#   $env:YATE_TRACE="1"; $env:YATE_TRACE_LEVEL="INFO"; yate   (PowerShell)
# YATE_TRACE accepts 1/true/yes/on and 0/false/no/off (0 also beats the
# yate_trace = True above). An unwritable log dir only warns on stderr.

# ------------------------------------------------------------- extensions
#
# yate ships with bundled extensions in yate/extensions/ (auto-loaded at
# startup from the package directory, regardless of the current directory):
#   python_lsp         Python language server support (autocomplete/diagnostics)
#   csharp_highlight   C# / .csx syntax highlighting
#
# Skip one or more bundled defaults by stem name (entries accumulate across
# rc files; user/project extension scripts keep loading regardless):
#
# disabled_extensions = ["python_lsp"]
# disabled_extensions = ["python_lsp", "csharp_highlight"]
#
# Extra extension scripts to load at startup. A path string or a list of
# paths; each entry is either a directory (all *.py inside are loaded) or a
# single .py file exposing setup(api). "~" is expanded; relative paths
# resolve against this yaterc file's own directory. Entries from the user
# rc and project rc accumulate; duplicates are loaded only once.
# yate/extensions/example_ext.py.example is a copy-and-rename template
# (drop the .example suffix); ./extensions and ~/.yate/extensions are also
# scanned automatically.
#
# extensions = "~/.yate/myext.py"
# extensions = [
#     "~/.yate/extensions",     # directory of extension scripts
#     "./tools/yate_exts",      # project-local directory
#     "./extra.py",             # individual script
# ]

# ------------------------------------------------------------ theme dirs
#
# Directories of custom color themes loaded at startup. Every *.py file in
# a directory is executed (underscore-prefixed files skipped); a single
# .py theme file is accepted as well. "~" is expanded and relative paths
# resolve against this yaterc file's own directory. Entries accumulate and
# de-duplicate across rc files. Without setting this option, yate also
# scans ./themes and ~/.yate/themes automatically, or use:
#     yate --theme-dir DIR        (repeatable; a single *.py file works too)
#     yate --theme my-mocha       (pick the theme at startup, overrides rc)
#
# theme_dirs = "~/.yate/themes"
# theme_dirs = ["~/.yate/themes", "./team-themes", "./extra/solarized.py"]
# theme = "my-mocha"          # then pick a registered theme by name

# ------------------------------------------------- language servers (LSP)
#
# Declarative LSP servers: no extension script needed. Once listed, the
# server for a file type starts automatically the first time a matching
# file is opened (one process per server x project root, lazily spawned).
# Required keys: name, command, filetypes (extensions without the leading
# dot; ".rs" is accepted too). A later yaterc replaces the whole list; a
# malformed entry is skipped and reported at startup. An entry whose name
# matches an extension server (e.g. "python") overrides that registration.
# See the LSP guide shipped at yate/docs/lsp.en.md (Chinese: lsp.zh.md).
#
# language_servers = [
#     {
#         "name": "rust-analyzer",
#         "command": "rust-analyzer",
#         "filetypes": ["rs"],
#         "language_ids": {"rs": "rust"},
#         "root_markers": ["Cargo.toml", ".git"],
#         # "args": [],                       # extra command-line arguments
#         # "env": {"RUST_LOG": "info"},     # extra environment variables
#         # "initialization_options": None,  # raw initializeOptions
#         # "settings": None,                # server settings
#     },
#     {
#         "name": "typescript",
#         "command": "typescript-language-server",
#         "args": ["--stdio"],
#         "filetypes": ["ts", "tsx", "js", "jsx"],
#         "language_ids": {
#             "ts": "typescript", "tsx": "typescriptreact",
#             "js": "javascript", "jsx": "javascriptreact",
#         },
#         "root_markers": ["package.json", "tsconfig.json", ".git"],
#     },
# ]

# ------------------------------------------------------- custom theme demo
#
# A theme is a yate.editor_view.theme.Theme instance. The easiest way to
# make one is to copy a built-in theme and override a few colors:
#
# from dataclasses import replace
# from yate.editor_view.theme import THEMES, register_theme
#
# register_theme(replace(
#     THEMES["mocha"],
#     name="my-mocha",          # must be unique
#     label="My Mocha",
#     accent="#89b4fa",         # primary blue (status bar / active tab)
#     accent2="#cba6f7",        # secondary mauve
#     syn_keyword="#cba6f7",    # syntax colors: keyword/string/number/...
# ))
# theme = "my-mocha"
